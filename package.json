{
  "name": "django-tailwind",
  "version": "1.0.0",
  "description": "Configuración de Tailwind para Django en Docker",
  "scripts": {
    "tailwind:build": "tailwindcss -i ./reportes/static/src/input.css -o ./reportes/static/dist/css/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./reportes/static/src/input.css -o ./reportes/static/dist/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}